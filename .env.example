JARVIS_MODE=google
JARVIS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: authenticates public model downloads for higher Hugging Face Hub limits.
# HF_TOKEN=
JARVIS_GEMINI_MODEL=gemini-3.8-flash
JARVIS_GEMINI_THINKING_LEVEL=low
# Streamed voice conversation uses this validated level; tool work is unchanged.
JARVIS_STT_MODEL=small.en
JARVIS_STT_BEAM_SIZE=5
# Comma-separated uncommon names or terms that Whisper should favor.
JARVIS_STT_HOTWORDS=Jarvis
JARVIS_STT_INITIAL_PROMPT=Jarvis personal assistant; Tell me something interesting; email, calendar, meeting, weather, forecast, contacts, Joo, Seoul, Busan
JARVIS_STT_VAD_FILTER=true
# Uncalibrated STT quality below this value must be repeated for actions/approvals.
JARVIS_STT_ACTION_CONFIDENCE_THRESHOLD=0.35
# Explicit local vocabulary is weakly injected; never raise this above 15.
JARVIS_STT_VOCABULARY_LIMIT=15
JARVIS_VOCABULARY_PATH=jarvis.vocabulary.json
# Print per-turn and session latency summaries without logging user content.
JARVIS_LATENCY_LOGGING=false
# Optional OpenAI fallback:
# OPENAI_API_KEY=
# JARVIS_OPENAI_MODEL=gpt-5.6-luna
# JARVIS_OPENAI_BASE_URL=

JARVIS_CONFIRM_DRAFTS=false
JARVIS_USER_NAME=
JARVIS_TIMEZONE=Asia/Seoul
JARVIS_DEFAULT_LOCATION=
JARVIS_WEATHER_TIMEOUT_SECONDS=5
JARVIS_DATABASE_PATH=jarvis.db
JARVIS_PERSISTENCE=sqlite

JARVIS_GOOGLE_CREDENTIALS=credentials.json
JARVIS_GOOGLE_TOKEN=google.token.json
JARVIS_ENABLE_GMAIL=true
JARVIS_ENABLE_CALENDAR=true
JARVIS_ENABLE_CONTACTS=true

# Keep these false until OAuth reads/drafts have been tested with your account.
JARVIS_ALLOW_EMAIL_SEND=false
JARVIS_ALLOW_CALENDAR_WRITES=false
